# ~/.zsh_aliases — managed by chezmoi
# Aliases are split into their own file to keep ~/.zshrc clean.

# ── File system ───────────────────────────────────────────────────────────────
alias ll='ls -alFh'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias mkdir='mkdir -p'

# ── Editors ───────────────────────────────────────────────────────────────────
alias vi='vim'

# ── Git ───────────────────────────────────────────────────────────────────────
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias glog='git log --oneline --graph --decorate'

# ── Docker ───────────────────────────────────────────────────────────────────
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias dpa='docker ps -a'

# ── Network ───────────────────────────────────────────────────────────────────
alias ports='ss -tulpn'
alias myip='curl -s https://api.ipify.org && echo'

# ── chezmoi ───────────────────────────────────────────────────────────────────
alias cz='chezmoi'
alias cza='chezmoi apply'
alias czd='chezmoi diff'
alias cze='chezmoi edit'
alias czu='chezmoi update'
alias czs='chezmoi status'
